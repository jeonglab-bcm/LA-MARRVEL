params {
    genecsv = null
    hpostxt = null
    input_vcf = null
    samples_manifest = null
    ref_ver = "hg19"
    aim_store_dir = "./aim_store"
    consideringgenes_g = 100
    invocationnumber_n = 10
    min_votes = 0
    reason_before_extract = true
    reuse_published_votes = false
    run_id = "run1"
    publishDirSuffix = ""
}

plugins {
    id 'nf-schema@2.3.0'
}
validation {
    help {
        enabled = true
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
    lenientMode = true
}
process {
    // LLM calls are non-deterministic: never reuse a cached invocation on -resume.
    withName: 'invokeLlms|reasonLlm|extractLlm' {
        cache = false
    }
}
