params {
    genecsv = null
    hpostxt = null
    input_vcf = null
    ref_ver = "hg19"
    aim_store_dir = "./aim_store"
    consideringgenes_g = 10
    invocationnumber_n = 10
    run_id = "run1"
}

plugins {
    id 'nf-schema@2.3.0'
}
validation {
    help {
        enabled = true
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
    lenientMode = true
}