params {
    genecsv = null
    hpostxt = null
    consideringgenes_g = 10
    invocationnumber_n = 10
    run_id = "run1"
    model = System.getenv("DEFAULT_LOCAL_MODEL") ?: null
}

plugins {
    id 'nf-schema@2.3.0'
}
validation {
    help {
        enabled = true
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
    lenientMode = true
}