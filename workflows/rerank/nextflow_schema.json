{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LA_MARRVEL_RERANK parameters",
  "description": "Inputs for the rerank workflow.",
  "type": "object",
  "properties": {
    "genecsv": {
      "type": "string",
      "description": "CSV exported from AI_MARRVEL containing candidate genes.",
      "format": "file-path"
    },
    "input_vcf": {
      "type": "string",
      "description": "VCF file containing variants for the proband.",
      "format": "file-path"
    },
    "ref_ver": {
      "type": "string",
      "defualt": "hg19",
      "description": "Reference genome version.",
      "enum": [
        "hg19",
        "hg38"
      ]
    },
    "aim_store_dir": {
      "type": "string",
      "default": "./aim_store",
      "description": "Directory where AI-MARRVEL stores its outputs.",
      "format": "directory-path"
    },
    "hpostxt": {
      "type": "string",
      "description": "Text file listing proband HPO IDs (one per line).",
      "format": "file-path"
    },
    "consideringgenes_g": {
      "type": "integer",
      "description": "Number of top genes to embed into each LLM prompt.",
      "default": 100,
      "minimum": 1
    },
    "invocationnumber_n": {
      "type": "integer",
      "description": "Number of prompt iterations / LLM votes.",
      "default": 10,
      "minimum": 1
    },
    "run_id": {
      "type": "string",
      "description": "Namespace for workflow outputs.",
      "default": "run1"
    }
  },
  "oneOf": [
    {
      "required": [
        "genecsv",
        "hpostxt"
      ]
    },
    {
      "required": [
        "input_vcf",
        "hpostxt"
      ]
    }
  ]
  }
