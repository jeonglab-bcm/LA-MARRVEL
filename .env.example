# Copy this file to `.env` and fill in your Bedrock-capable IAM user's credentials.
# The helper scripts load credentials via `python-dotenv`, so having a `.env` makes
# local runs consistent with non-interactive CI environments.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
