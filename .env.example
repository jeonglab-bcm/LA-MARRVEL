# Copy this file to `.env` and fill in the settings for the provider you use.
# The helper scripts load this file via `python-dotenv`, so having a `.env` makes
# local runs consistent with non-interactive CI environments.
# Real environment variables take precedence over the values set here.

# --- How the two steps of a vote run ----------------------------------------
# unified (default): reasoning and extraction run in one task, so a retry
#   resamples the reasoning too.
# stratified: separate tasks; with --reason_before_extract (the default) every
#   reasoning call finishes before the first extraction starts, and a retry
#   re-extracts the same reasoning output.
# Read by workflows/rerank/main.nf; a real environment variable wins here too.
RUN_STRATEGY=unified

# --- Which backend runs which step ------------------------------------------
# The pipeline calls two models and each picks its backend independently:
#   reasoning  -> bin/invoke_reasoning_llm.py   (long-form analysis, thinking on)
#   extraction -> bin/invoke_prioritize_llm.py  (structured gene-rank extraction)
# Valid values: `bedrock` or `openai`.

# Default for any role that is not set explicitly.
PROVIDER=bedrock

# Per-role overrides. Example: reason on a local OpenAI-compatible server, then
# extract the ranking with Bedrock.
# REASONING_PROVIDER=openai
# EXTRACTION_PROVIDER=bedrock

# Every setting below can also be scoped to one role by inserting REASONING or
# EXTRACTION after the provider prefix; the unscoped name is the fallback:
#   OPENAI_REASONING_BASE_URL   -> OPENAI_BASE_URL
#   BEDROCK_EXTRACTION_MODEL_ID -> BEDROCK_MODEL_ID
# (`PRIORITIZE` is still accepted as an alias for `EXTRACTION`.)

# --- bedrock ----------------------------------------------------------------
# Credentials for a Bedrock-capable IAM user; shared by both roles.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
# Optional overrides.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_REASONING_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_EXTRACTION_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
# BEDROCK_MAX_TOKENS=65536
# BEDROCK_THINKING_BUDGET_TOKENS=50000

# --- openai -----------------------------------------------------------------
# Any OpenAI-compatible `/v1` server, e.g. a llama.cpp llama-server hosting a
# Hugging Face model:
#   llama-server -hf <org>/<repo> --jinja --reasoning-format deepseek -c 32768
# OPENAI_BASE_URL=http://dspark1.ad.bcm.edu/v1
# OPENAI_API_KEY=sk-no-key-required            # llama.cpp ignores it, the client requires one
# OPENAI_MODEL=local-model                     # served model name; llama.cpp accepts anything
# OPENAI_MAX_TOKENS=65536
# OPENAI_TIMEOUT=3600                          # seconds; local reasoning runs are slow
# OPENAI_TEMPERATURE=0.8                       # unset = server default (keeps the votes diverse)
# OPENAI_ENABLE_THINKING=true                  # chat_template_kwargs for Qwen3-style templates
# OPENAI_STRUCTURED_OUTPUT_METHOD=json_schema  # or function_calling / json_mode
# OPENAI_EXTRA_BODY={"top_k": 20}              # JSON merged into every request body

# Role-scoped versions, for two different OpenAI-compatible endpoints. The
# extraction step keeps its own sampling settings (temperature 0.0, thinking
# off) rather than inheriting OPENAI_TEMPERATURE / OPENAI_ENABLE_THINKING.
# OPENAI_REASONING_BASE_URL=http://dspark1.ad.bcm.edu/v1
# OPENAI_REASONING_MODEL=local-model
# OPENAI_EXTRACTION_BASE_URL=https://api.openai.com/v1
# OPENAI_EXTRACTION_API_KEY=sk-...
# OPENAI_EXTRACTION_MODEL=gpt-4.1-mini
# OPENAI_EXTRACTION_TEMPERATURE=0.0
# OPENAI_EXTRACTION_ENABLE_THINKING=false

# --- tracing (optional) -----------------------------------------------------
# Set both keys to send every reasoning and extraction call to Langfuse. With
# either one unset the pipeline runs exactly as before and traces nothing.
# Each sample's `run_id` becomes the Langfuse session id, so one sample's N
# votes and their extraction passes sit together; the iteration number, role
# and backend are recorded on every trace.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com    # or your self-hosted instance
# LANGFUSE_TRACING_ENABLED=false              # keep the keys, switch tracing off
# LANGFUSE_TRACING_ENVIRONMENT=production     # separates cohorts from test runs
# LANGFUSE_RELEASE=rerank-v1                  # e.g. a git tag or commit
# LANGFUSE_SAMPLE_RATE=0.2                    # trace a fraction of large cohorts
# LANGFUSE_TIMEOUT=5                          # seconds a task waits on the flush
